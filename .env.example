# Copy to .env for local development

# Required — from your Productboard OAuth app settings
PB_OAUTH_CLIENT_ID=your_client_id
PB_OAUTH_CLIENT_SECRET=your_client_secret

# Required — public URL of this service
# Local dev: use ngrok or similar, e.g. https://abc123.ngrok.io
# Cloud Run: the Cloud Run service URL
APP_URL=https://your-service.run.app

# Required — random string, used to sign session cookies
SESSION_SECRET=change-me-to-a-random-string

# Optional
PORT=3000
PB_EU=false
GCP_PROJECT_ID=your-gcp-project  # enables Secret Manager token storage
